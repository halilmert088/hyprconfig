{
  "layer": "top",
  "position": "top",
  "modules-center": ["clock"],
  "modules-left": ["hyprland/workspaces", "hyprland/submap"],
  "modules-right": ["pulseaudio", "custom/vpn", "network", "bluetooth", "disk", "memory", "cpu"],
  "hyprland/workspaces": {
    "persistent-workspaces": {
            "*": [ 1,2,3,4,5,6 ]
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": {
       "default": ["", "", "", ""]
    },
    "on-click": "pavucontrol"
  },
  "clock": {
    "format": "󰥔 {:%d %b %Y %a, %H:%M}",
    "interval": 60,
    "timezone": "Europe/Istanbul"
  },
  "network": {
    "format": "{icon}",
    "format-icons": {
      "wifi": "",
      "ethernet": "",
      "disconnected": "󰤮",
      "default": ""
    },
    "tooltip-format": "{ifname}",
    "tooltip-format-disconnected": "Disconnected :(",
    "max-length": 50,
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "",
    "format-connected": "󰂱",
    "tooltip-format": "O devices connected",
    "tooltip-format-connected": "{num_connections} device(s) connected",
    "tooltip-format-disabled": "Bluetooth disabled",
    "on-click": "blueman-manager"
  },
  "custom/vpn": {
    "format": "{}",
    "exec": "~/.config/waybar/vpn_status.sh",
    "return-type": "json",
    "tooltip": true,
    "on-click": "~/.config/waybar/vpn.sh",
    "interval": 1
  },
  "memory": {
    "interval": 30,
    "format": "{}% ",
    "tooltip-format": "{percentage} % mem used",
    "max-length": 10
  },
  "disk": {
    "interval": 30,
    "format": "{percentage_used}% ",
    "tooltip-format": "{percentage_used}% used",
    "unit": "GB",
    "path": "/",
    "max-length": 50
  },
  "cpu": {
    "interval": 10,
    "format": "{}% ",
    "tooltip-format": "CPU load: {load}%",
    "max-length": 10
  }
}
